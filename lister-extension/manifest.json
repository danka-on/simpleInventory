{
  "manifest_version": 3,
  "name": "Sweet Shelves Lister",
  "version": "0.2.70",
  "description": "List the Sweet Shelves queue on eBay and Amazon: UPC search, auto-fill, guided fields, prep notes and photos, then link the live listing back to the warehouse. Also reads the Facebook Marketplace inbox (never personal chats) for new buyer messages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Sweet Shelves Lister",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://pi.nexuscentralhq.org/*",
    "https://*.ebay.com/*",
    "https://sellercentral.amazon.com/*",
    "https://www.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pi.nexuscentralhq.org/lister/*"
      ],
      "js": [
        "update-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pi.nexuscentralhq.org/items-to-list*"
      ],
      "js": [
        "queue-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/marketplace/*"
      ],
      "js": [
        "fb-inbox.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Open Sweet Shelves Lister"
    }
  }
}
