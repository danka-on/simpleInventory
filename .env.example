EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_RUNAME=your-ebay-runame
# NOTE: Sell Account API (business policies) requires sell.account (or sell.account.readonly).
EBAY_SCOPE=https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.fulfillment https://api.ebay.com/oauth/api_scope/sell.logistics https://api.ebay.com/oauth/api_scope/sell.finances https://api.ebay.com/oauth/api_scope/sell.account https://api.ebay.com/oauth/api_scope/sell.marketing https://api.ebay.com/oauth/api_scope/sell.analytics.readonly
EBAY_BUY_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_OLDAUTH_TOKEN=your-ebay-auth-token
# Optional fallback dates. Provider-reported expiry is preferred when available.
EBAY_OAUTH_REFRESH_TOKEN_EXPIRES_AT=YYYY-MM-DD
EBAY_OLDAUTH_TOKEN_EXPIRES_AT=YYYY-MM-DD

# If this Amazon authorization must be renewed annually, its runtime token
# response does not expose that date. Set one of these for 14-day reminders.
AMAZON_REFRESH_TOKEN_AUTHORIZED_AT=YYYY-MM-DD
# AMAZON_REFRESH_TOKEN_EXPIRES_AT=YYYY-MM-DD

# Email Configuration (for automated alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
GOOGLE_SHEETS_SHARED_SPREADSHEET_ID=your-shared-google-spreadsheet-id

# Optional: IMAP inbox settings (used for Mail Center Amazon forwarded-email sync)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_MAILBOX=INBOX

# Flask
FLASK_SECRET_KEY=generate-a-random-hex-string-here
