EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_RUNAME=your-ebay-runame
# NOTE: Sell Account API (business policies) requires sell.account (or sell.account.readonly).
EBAY_SCOPE=https://api.ebay.com/oauth/api_scope https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.fulfillment https://api.ebay.com/oauth/api_scope/sell.account
EBAY_BUY_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_OLDAUTH_TOKEN=your-ebay-auth-token

# Email Configuration (for automated alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Flask
FLASK_SECRET_KEY=generate-a-random-hex-string-here
